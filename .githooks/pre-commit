#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

prettier="$repo_root/node_modules/.bin/prettier"
if [[ ! -x "$prettier" ]]; then
  echo "pre-commit: install dependencies with npm install before committing." >&2
  exit 1
fi

staged_files=()
while IFS= read -r -d '' file; do
  case "$file" in
    src/routeTree.gen.ts) ;;
    *) staged_files+=("$file") ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if ((${#staged_files[@]} == 0)); then
  exit 0
fi

echo "pre-commit: checking staged files with Prettier"
"$prettier" --check --ignore-unknown "${staged_files[@]}"
